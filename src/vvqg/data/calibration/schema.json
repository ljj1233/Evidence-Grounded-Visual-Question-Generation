{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "new_vqg/calibration/schema.json",
  "title": "VQG reward-calibration record",
  "description": "Labeled (image, question) pair used to calibrate/validate the reward.",
  "type": "object",
  "required": [
    "image",
    "question",
    "validity_label",
    "grounding_label",
    "information_gain_label"
  ],
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "string",
      "minLength": 1,
      "description": "Reference to the input image (path, not embedded bytes)."
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "description": "Question under reward calibration."
    },
    "validity_label": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Question validity score in [0, 1]."
    },
    "grounding_label": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Visual grounding score in [0, 1]."
    },
    "information_gain_label": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Information usefulness / gain score in [0, 1]."
    }
  }
}
